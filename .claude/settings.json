{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/hooks/protect_folder.py\" --protected protected",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/hooks/check_json.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/hooks/record_check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
